# Documentation template only. Never place real values in Git.
# Cloudflare local runtime: copy these names into ignored .dev.vars.
AI_PROVIDER=mock
AI_TIMEOUT_MS=15000
# Set AI_PROVIDER=openai only after all paid-call guards below are configured.
# Supported model family; name is read only from this server environment.
AI_MODEL=gpt-5.4-mini
AI_API_KEY=

# Server-only trial controls. Blank pricing blocks paid calls. No real credentials here.
AI_PRICING_JSON=
AI_PROJECT_ID=
AI_HARD_LIMIT_VERIFIED=false
# Optional protected status endpoint; set a random secret of at least 32 characters.
AI_BUDGET_ADMIN_TOKEN=
